{
"$schema": "https://schemas.wp.org/trunk/theme.json",
"version": 3,
"settings": {
"color": {
"palette": [
{
"slug": "rocean-ocean",
"color": "#075B73",
"name": "Rocean Ocean"
},
{
"slug": "rocean-gold",
"color": "#FCA311",
"name": "Rocean Gold"
},
{
"slug": "rocean-mocha",
"color": "#6B4A3A",
"name": "Rocean Mocha"
},
{
"slug": "rocean-carmel",
"color": "#C48A5A",
"name": "Rocean Carmel"
},
{
"slug": "rocean-white",
"color": "#FFFFFF",
"name": "Rocean White"
},
{
"slug": "rocean-text",
"color": "#222222",
"name": "Rocean Text"
},
{
"slug": "rocean-background",
"color": "#F5FAFB",
"name": "Rocean Background"
}
]
}
},
"styles": {
"color": {
"background": "var(--wp--preset--color--rocean-background)",
"text": "var(--wp--preset--color--rocean-text)"
},
"elements": {
"button": {
"color": {
"background": "var(--wp--preset--color--rocean-gold)",
"text": "var(--wp--preset--color--rocean-white)"
},
"border": {
"radius": "4px"
},
"spacing": {
"padding": {
"top": "12px",
"bottom": "12px",
"left": "24px",
"right": "24px"
}
}
},
"link": {
"color": {
"text": "var(--wp--preset--color--rocean-ocean)"
},
":hover": {
"color": {
"text": "var(--wp--preset--color--rocean-gold)"
}
}
}
}
}
}
